{
  "manifest_version": 3,
  "name": "Phoenix Health",
  "version": "1.0",
  "description": "Shows this computer's Phoenix health status: green (fine), yellow (warning) or red (problem), with notifications.",
  "permissions": [
    "notifications",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8098/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Phoenix Health",
    "default_popup": "popup.html"
  },
  "key": ""
}
