#!/bin/sh
# phoenix: the Phoenix command (also installed as `vostro`). Scripts come from the Phoenix server.
#   phoenix fix          apply the latest fixes for this machine (default)
#   phoenix platform     view/configure platform modules, CPU profile and fan (add "menu" for a menu)
#   phoenix detect       show what Phoenix detects about this computer
#   phoenix hostname N   set the name your router sees for this computer
#   phoenix touchpad M   switch touchpad mode: alps | alps2 | exps
#   phoenix save         keep this system's fixes across ChromeOS updates and Brunch rebuilds
#   phoenix diag         collect logs and send them to the Phoenix server
#   phoenix install      install ChromeOS + Phoenix onto the internal drive
#   phoenix update       update this command
#   add -v (--verbose) to any command to see every step
H=HOST:8099
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
V=0; CMD=""; REST=""
for a in "$@"; do
  case "$a" in -v|--verbose) V=1 ;; *) [ -z "$CMD" ] && CMD=$a || REST="$REST $a" ;; esac
done
export VERBOSE=$V PHOENIX_SERVER=$H
SH="sh"; [ $V = 1 ] && SH="sh -x"
case "${CMD:-fix}" in
  fix)      curl -s http://$H/m | $SH ;;
  platform) curl -s http://$H/p | $SH -s $REST ;;
  detect)   curl -s http://$H/pd | $SH -s --summary ;;
  hostname) curl -s http://$H/h | $SH -s $REST ;;
  touchpad) curl -s http://$H/t | $SH -s $REST ;;
  save)     curl -s http://$H/s | $SH ;;
  diag)     curl -s http://$H/d | $SH ;;
  install)  curl -s http://$H/m | VOSTRO_INSTALL=1 $SH || exit 1   # make sure the running system has every fix first
            curl -s http://$H/i -o /tmp/phoenix-install.sh
            if [ $V = 1 ]; then bash -x /tmp/phoenix-install.sh $REST; else bash /tmp/phoenix-install.sh $REST; fi ;;
  update)   curl -s http://$H/v | $SH ;;
  *)        sed -n '3,12p' "$0" ;;
esac
